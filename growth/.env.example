# Copy this to growth/.env and fill it. growth/.env is gitignored — never commit it.

# --- Gmail (use an APP PASSWORD, not your login password) ---
# Google Account -> Security -> turn on 2-Step Verification -> App passwords
GMAIL_USER=yourname@student.yourschool.edu.ng
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Who you are (goes in the copy) ---
SENDER_NAME=Your Name
SCHOOL=UNN
TUTORX_LINK=https://tutor-x-five.vercel.app/

# --- Pacing guardrails (safe defaults; raise slowly as the account warms) ---
PER_RUN_CAP=30
MIN_DELAY_MS=45000
MAX_DELAY_MS=90000
